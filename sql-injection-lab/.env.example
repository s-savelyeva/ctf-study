# Порт веб-сервиса на хосте
WEB_PORT=8000
# Порт MySQL на хосте (для атак через UNION/слепые инъекции извне не нужен, но полезен для защиты/отладки)
DB_PORT=3306
# Пароль root в MySQL (перед игрой смените!)
DB_ROOT_PASS=ctf_root_pass
# Ключ подписи cookie-сессий Flask (перед игрой смените!)
APP_SECRET_KEY=ctf-insecure-dev-key
